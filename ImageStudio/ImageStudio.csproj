<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Debug: okno konsoli z logami (ILogger); Release: bez konsoli -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>ImageStudio.Program</StartupObject>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <RootNamespace>ImageStudio</RootNamespace>
    <AssemblyName>ImageStudio</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Publikacja do jednego pliku (profile w Properties\PublishProfiles): dostawcy i zakładki wchodzą do paczki,
         więc nie ma podfolderów providers\ i tabs\ -->
    <PluginsInBundle Condition="'$(PublishSingleFile)' == 'true'">true</PluginsInBundle>
    <PluginsInBundle Condition="'$(PluginsInBundle)' == ''">false</PluginsInBundle>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wbudowany, żeby publikacja do jednego pliku nie zostawiała pliku obok exe -->
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageStudio.Providers.Core\ImageStudio.Providers.Core.csproj" />
    <ProjectReference Include="..\ImageStudio.Shared\ImageStudio.Shared.csproj" />
    <ProjectReference Include="..\ImageStudio.Storage.Core\ImageStudio.Storage.Core.csproj" />
    <ProjectReference Include="..\ImageStudio.Tools.Core\ImageStudio.Tools.Core.csproj" />
    <!-- Zakładki lewego panelu: osobne projekty, ich DLL-e trafiają do podfolderu tabs\ (jak dostawcy do providers\) -->
    <ProjectReference Include="..\ImageStudio.Tabs.Generate\ImageStudio.Tabs.Generate.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tabs.Edit\ImageStudio.Tabs.Edit.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tabs.Video\ImageStudio.Tabs.Video.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tabs.Chat\ImageStudio.Tabs.Chat.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tabs.Voice\ImageStudio.Tabs.Voice.csproj" Private="$(PluginsInBundle)" />
    <!-- Dostawcy: Private=false nie kopiuje ich do katalogu głównego; target niżej układa je w providers\ -->
    <ProjectReference Include="..\ImageStudio.Providers.UberLlm\ImageStudio.Providers.UberLlm.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.OpenRouter\ImageStudio.Providers.OpenRouter.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.OpenAi\ImageStudio.Providers.OpenAi.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.ChatGpt\ImageStudio.Providers.ChatGpt.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.Mistral\ImageStudio.Providers.Mistral.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.Kilo\ImageStudio.Providers.Kilo.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Providers.OpenCodeGo\ImageStudio.Providers.OpenCodeGo.csproj" Private="$(PluginsInBundle)" />
    <!-- Magazyny wyników (IMediaStorage): jak dostawcy, trafiają do podfolderu storage\ -->
    <ProjectReference Include="..\ImageStudio.Storage.Local\ImageStudio.Storage.Local.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Storage.Cloud\ImageStudio.Storage.Cloud.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Storage.OneDrive\ImageStudio.Storage.OneDrive.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Storage.GoogleDrive\ImageStudio.Storage.GoogleDrive.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Storage.Mega\ImageStudio.Storage.Mega.csproj" Private="$(PluginsInBundle)" />
    <!-- Grupy narzędzi czatu (IChatToolGroup): jak dostawcy, trafiają do podfolderu tools\ -->
    <ProjectReference Include="..\ImageStudio.Tools.DateTime\ImageStudio.Tools.DateTime.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tools.Memory\ImageStudio.Tools.Memory.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tools.Files\ImageStudio.Tools.Files.csproj" Private="$(PluginsInBundle)" />
    <ProjectReference Include="..\ImageStudio.Tools.Skills\ImageStudio.Tools.Skills.csproj" Private="$(PluginsInBundle)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!-- Biblioteki dostawców i zakładek trafiają do podfolderów providers\ i tabs\ (build i publish); wczytuje je App
       (AssemblyLoadContext.Resolving). ImageStudio.Providers.Core i ImageStudio.Shared zostają w katalogu głównym -->
  <Target Name="CollectPluginDlls" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <ProviderDll Include="@(ReferencePath)" Condition="$([System.String]::new('%(Filename)').StartsWith('ImageStudio.Providers.')) And '%(Filename)' != 'ImageStudio.Providers.Core'" />
      <ProviderFile Include="@(ProviderDll)" />
      <ProviderFile Include="@(ProviderDll->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
      <ToolDll Include="@(ReferencePath)" Condition="$([System.String]::new('%(Filename)').StartsWith('ImageStudio.Tools.')) And '%(Filename)' != 'ImageStudio.Tools.Core'" />
      <ToolFile Include="@(ToolDll)" />
      <ToolFile Include="@(ToolDll->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
      <StorageDll Include="@(ReferencePath)" Condition="$([System.String]::new('%(Filename)').StartsWith('ImageStudio.Storage.')) And '%(Filename)' != 'ImageStudio.Storage.Core'" />
      <StorageFile Include="@(StorageDll)" />
      <StorageFile Include="@(StorageDll->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
      <TabDll Include="@(ReferencePath)" Condition="$([System.String]::new('%(Filename)').StartsWith('ImageStudio.Tabs.'))" />
      <TabFile Include="@(TabDll)" />
      <TabFile Include="@(TabDll->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

  <!-- Lista bibliotek magazynu (te same co storage\) jako [assembly: AssemblyMetadata("ImageStudio.StoragePlugin", nazwa)]:
       z niej StoragePluginDiscovery odkrywa wtyczki. GetReferencedAssemblies() ich nie zna (kompilator pomija
       biblioteki, których typów kod nie używa), a metadane działają też w exe jednoplikowym i w testach -->
  <Target Name="AddStoragePluginMetadata" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="CollectPluginDlls">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ImageStudio.StoragePlugin</_Parameter1>
        <_Parameter2>%(StorageDll.Filename)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="CopyPluginDlls" AfterTargets="Build" Condition="'$(PluginsInBundle)' != 'true'" DependsOnTargets="CollectPluginDlls">
    <Copy SourceFiles="@(ProviderFile)" DestinationFolder="$(OutDir)providers" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TabFile)" DestinationFolder="$(OutDir)tabs" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ToolFile)" DestinationFolder="$(OutDir)tools" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StorageFile)" DestinationFolder="$(OutDir)storage" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishPluginDlls" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PluginsInBundle)' != 'true'" DependsOnTargets="CollectPluginDlls">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(ProviderFile)" RelativePath="providers\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(TabFile)" RelativePath="tabs\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(ToolFile)" RelativePath="tools\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(StorageFile)" RelativePath="storage\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- Publikacja do jednego pliku: bez symboli obok exe -->
  <Target Name="CleanSingleFilePublishDir" AfterTargets="Publish" Condition="'$(PluginsInBundle)' == 'true'">
    <ItemGroup>
      <LeftoverPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(LeftoverPdb)" />
  </Target>

</Project>
