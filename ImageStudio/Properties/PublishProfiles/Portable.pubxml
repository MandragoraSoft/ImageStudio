<?xml version="1.0" encoding="utf-8"?>
<!-- Wersja zwykła: jeden exe (~kilka MB), wymaga zainstalowanych środowisk .NET 10 Desktop i ASP.NET Core (Windows 10+ x64) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <PluginsInBundle>true</PluginsInBundle>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\/portable\</PublishDir>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
