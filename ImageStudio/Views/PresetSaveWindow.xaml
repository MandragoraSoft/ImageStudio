<Window x:Class="ImageStudio.Views.PresetSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="{loc:T common.savePreset}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T presetSave.suggest}" Padding="10,2" Command="{Binding SuggestCommand}"
                    Visibility="{Binding CanSuggestVisible, Converter={StaticResource BoolToVis}}"
                    ToolTip="{loc:T presetSave.suggest.tip}"/>
            <TextBlock Text="{loc:T common.name}" Style="{StaticResource SectionHeader}"/>
        </DockPanel>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>

        <TextBlock Text="{loc:T presetSave.description}" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="{loc:T common.prompt}" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding Prompt, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <TextBlock Text="{loc:T presetSave.note}"
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button Content="{loc:T common.save}" IsDefault="True" Width="90" Click="Save_Click" IsEnabled="{Binding CanSave}"/>
        </StackPanel>
    </StackPanel>
</Window>
