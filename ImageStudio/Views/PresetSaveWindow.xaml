<Window x:Class="ImageStudio.Views.PresetSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Title="Zapisz zestaw" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Zaproponuj (AI)" Padding="10,2" Command="{Binding SuggestCommand}"
                    Visibility="{Binding CanSuggestVisible, Converter={StaticResource BoolToVis}}"
                    ToolTip="Model tekstowy proponuje nazwę i opis na podstawie promptu"/>
            <TextBlock Text="Nazwa" Style="{StaticResource SectionHeader}"/>
        </DockPanel>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>

        <TextBlock Text="Opis (opcjonalnie)" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="Prompt" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding Prompt, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="200" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <TextBlock Text="Zestaw zapisze prompt, model, rozmiar, parametry i ustawienia ulepszania. Nazwa pliku powstaje automatycznie."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Anuluj" IsCancel="True" Width="90" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Content="Zapisz" IsDefault="True" Width="90" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
