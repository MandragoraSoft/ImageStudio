<UserControl x:Class="ImageStudio.Views.AppSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,8,0">
            <TextBlock Text="{loc:T settings.language}" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{loc:T settings.maxSide}" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding MaxSide, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>

            <TextBlock Text="{loc:T settings.galleryArchive}" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding GalleryArchiveFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T settings.galleryArchive.tip}"/>
                <Button Grid.Column="1" Content="{loc:T settings.galleryArchive.browse}" Margin="6,0,0,0" Padding="10,2"
                        Click="BrowseArchive_Click" Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <TextBlock Text="{loc:T settings.chat}" Style="{StaticResource SectionHeader}"/>
            <CheckBox Content="{loc:T settings.streaming}" IsChecked="{Binding UseStreaming}"
                      ToolTip="{loc:T settings.streaming.tip}"/>

            <TextBlock Text="{loc:T settings.promptChat}" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding PromptChatModes}" SelectedValuePath="Mode" SelectedValue="{Binding SelectedPromptChatHistory}"
                      ToolTip="{loc:T settings.promptChat.tip}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{loc:T settings.theme}" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedValuePath="Code" SelectedValue="{Binding SelectedTheme}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
