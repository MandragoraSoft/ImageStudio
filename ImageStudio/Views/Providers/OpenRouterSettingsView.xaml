<UserControl x:Class="ImageStudio.Views.OpenRouterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <StackPanel>
        <TextBlock Text="Klucz API (openrouter.ai)" Style="{StaticResource SectionHeader}"/>
        <PasswordBox views:PasswordBoxBehavior.BoundPassword="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Modele tekstowe, obrazowe i wideo są dostępne. Ceny obrazów to cena tokenów (za 1M), wideo: za sekundę, gdy katalog ją podaje."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
