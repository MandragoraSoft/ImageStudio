<UserControl x:Class="ImageStudio.Views.OpenAiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <StackPanel>
        <TextBlock Text="Adres bazowy" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Np. https://api.openai.com albo adres proxy / serwera kompatybilnego z OpenAI"/>

        <TextBlock Text="Klucz API" Style="{StaticResource SectionHeader}"/>
        <PasswordBox views:PasswordBoxBehavior.BoundPassword="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Wideo nie jest obsługiwane przez ten provider."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
