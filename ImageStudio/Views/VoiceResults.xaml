<UserControl x:Class="ImageStudio.Views.VoiceResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <!-- Wyniki zakładki Głos (DataContext = VoiceViewModel): nagrania z syntezy i teksty z rozpoznawania -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="8,8,8,0">
            <Button DockPanel.Dock="Right" Content="{loc:T voice.clearGallery}" Padding="12,5" Style="{StaticResource SecondaryButton}"
                    ToolTip="{loc:T voice.clearGallery.tip}" Command="{Binding ClearGalleryCommand}"/>
            <TextBlock x:Name="GalleryHeader" Text="{Binding GalleryLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="{loc:T voice.empty}"
                   TextWrapping="Wrap" HorizontalAlignment="Center"
                   VerticalAlignment="Center" MaxWidth="360" TextAlignment="Center">
            <TextBlock.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Resources>
        </TextBlock>
        <ListBox x:Name="ResultList" Grid.Row="1" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch" BorderThickness="0"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8,8,8,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T gallery.repeat}"
                                          Command="{Binding PlacementTarget.Tag.RepeatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="{loc:T gallery.remove}"
                                          Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="{loc:T gallery.removeFile}"
                                          Command="{Binding PlacementTarget.Tag.DeleteWithFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="{loc:T voice.copyText}"
                                          Command="{Binding PlacementTarget.Tag.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Footer}" FontSize="11" Style="{StaticResource MutedTextBlock}"/>
                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" Padding="0" Margin="0,6,0,8" MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto"/>
                            <WrapPanel>
                                <Button Content="{loc:T voice.play}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{loc:T voice.openExternal}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        ToolTip="{loc:T voice.openExternal.tip}"
                                        Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenExternallyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{loc:T voice.stop}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.StopPlaybackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                <Button Content="{loc:T voice.saveAs}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.SaveAsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{loc:T voice.copyText}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{loc:T voice.toSynth}" Padding="12,5" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}"
                                        ToolTip="{loc:T voice.toSynth.tip}"
                                        Command="{Binding DataContext.UseAsSpeechTextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="{loc:T common.remove}" Padding="12,5" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
