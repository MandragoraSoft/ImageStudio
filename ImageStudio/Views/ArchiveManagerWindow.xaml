<Window x:Class="ImageStudio.Views.ArchiveManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="{loc:T archive.title}" Width="960" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Źródło listy i zaznaczanie -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:T archive.selectAll}" Command="{Binding SelectAllCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                <Button Content="{loc:T archive.clearSelection}" Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="{loc:T archive.source.local}" IsChecked="{Binding IsLocalSource}" Margin="0,0,16,0"/>
                <RadioButton Content="{loc:T archive.source.cloud}" IsChecked="{Binding IsCloudSource}"/>
            </StackPanel>
        </DockPanel>

        <!-- Miniatury z polem wyboru; klik w miniaturę ustawia podgląd -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="170" Margin="0,0,8,8" Padding="6" CornerRadius="6"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Button Command="{Binding DataContext.PreviewItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Background="Transparent"
                                        BorderThickness="0" Padding="0" ToolTip="{Binding Entry.Model}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="{Binding Entry.Thumbnail}" Height="110" Stretch="Uniform"/>
                                </Button>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Entry.KindLabel}" TextTrimming="CharacterEllipsis" MaxWidth="130"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </CheckBox>
                                <TextBlock Text="{Binding Entry.Model}" Style="{StaticResource MutedTextBlock}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Podgląd wybranego wpisu: obraz w pełnym rozmiarze, nazwa pliku i kopiowanie do schowka -->
        <Border Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Padding="10" CornerRadius="6"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewFileName}" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <Button DockPanel.Dock="Bottom" Content="{loc:T archive.copy}" Command="{Binding CopyPreviewCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <Grid>
                    <TextBlock Text="{loc:T archive.preview.empty}"
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Przeniesienie do aktywnej chmury, pasek statusu i zamknięcie -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:T common.close}" IsCancel="True" MinWidth="100" Margin="8,0,0,0"/>
            <Button Content="{Binding MoveToCloudLabel}" Command="{Binding MoveToCloudCommand}" Padding="12,6"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis" Style="{StaticResource MutedTextBlock}"/>
        </DockPanel>
    </Grid>
</Window>
