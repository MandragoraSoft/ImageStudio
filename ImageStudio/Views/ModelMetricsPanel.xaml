<UserControl x:Class="ImageStudio.Views.ModelMetricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Panel}">
        <StackPanel>
            <TextBlock Text="{Binding ActiveModel.Id, TargetNullValue='Brak modelu'}"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Cena teraz:" Margin="0,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Column="1" Margin="0,2" FontWeight="SemiBold"
                           Text="{Binding ActiveModel.Pricing.PriceNow, StringFormat='${0:0.0000}', TargetNullValue='—'}"/>
                <TextBlock Grid.Column="2" Text="Katalog:" Margin="10,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Column="3" Margin="0,2"
                           Text="{Binding ActiveModel.Pricing.ListUsd, StringFormat='${0:0.0000}', TargetNullValue='—'}"/>

                <TextBlock Grid.Row="1" Text="Rabat:" Margin="0,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2"
                           Text="{Binding ActiveModel.Pricing.DiscountPct, StringFormat='{}{0:0.#}%', TargetNullValue='—'}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Jednostka:" Margin="10,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,2"
                           Text="{Binding ActiveModel.Pricing.Unit, TargetNullValue='—'}"/>

                <TextBlock Grid.Row="2" Text="Oferty:" Margin="0,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2"
                           Text="{Binding ActiveModel.Pricing.MarketOffers, TargetNullValue='—'}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Żądań 24h:" Margin="10,2,6,2" Style="{StaticResource MutedTextBlock}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,2"
                           Text="{Binding ActiveModel.Pricing.Requests24h, StringFormat='{}{0:0}', TargetNullValue='—'}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
