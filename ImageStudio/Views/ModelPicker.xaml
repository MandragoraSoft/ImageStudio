<UserControl x:Class="ImageStudio.Views.ModelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ImageStudio.ViewModels"
             xmlns:views="clr-namespace:ImageStudio.Views"
             x:Name="Picker">
    <!-- Wspólny selektor modelu: akordeon z nagłówkiem = wybrany model, lista modeli z dowolnego źródła
         (ModelOption lub tekst) i opcjonalny panel filtrów (HasFilters; filtry biorą DataContext z rodzica) -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ModelOption}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModelItemTemplate}"/>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Picker}" Style="{StaticResource SectionHeader}"/>
        <Expander x:Name="Accordion" HorizontalContentAlignment="Stretch" FontWeight="Normal" Margin="0,0,0,6"
                  Expanded="Accordion_Expanded">
            <Expander.Header>
                <ContentControl Content="{Binding SelectedItem, ElementName=Picker}" HorizontalContentAlignment="Stretch"/>
            </Expander.Header>
            <StackPanel Margin="0,4,0,0">
                <ToggleButton x:Name="FiltersToggle" Content="Filtry modeli" Padding="10,2" HorizontalAlignment="Left" Margin="0,0,0,4"
                              Visibility="{Binding HasFilters, ElementName=Picker, Converter={StaticResource BoolToVis}}"/>
                <views:ModelFilterBar Margin="0,0,0,4"
                                      Visibility="{Binding IsChecked, ElementName=FiltersToggle, Converter={StaticResource BoolToVis}}"/>
                <ListBox x:Name="List" MaxHeight="260" HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding ItemsSource, ElementName=Picker}"
                         SelectedItem="{Binding SelectedItem, ElementName=Picker}"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" PreviewKeyDown="List_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
