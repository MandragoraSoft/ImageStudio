<Window x:Class="ImageStudio.Views.PromptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        xmlns:views="clr-namespace:ImageStudio.Views"
        Style="{StaticResource WindowBase}"
        Width="1100" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Edytor promptu w oknie modalnym: lewa kolumna to koncept (i konfiguracja), prawa to przebudowa AI i opis obrazów -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel x:Name="PresetBar" Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="OverwriteButton" DockPanel.Dock="Right" Content="{loc:T prompt.overwrite}" Padding="12,4" Margin="8,0,0,0" Click="Overwrite_Click"
                    IsEnabled="False" ToolTip="{loc:T prompt.overwrite.tip}"/>
            <Button DockPanel.Dock="Right" Content="{loc:T common.load}" Padding="12,4" Margin="8,0,0,0" Click="LoadPreset_Click"
                    ToolTip="{loc:T prompt.load.tip}"/>
            <TextBlock DockPanel.Dock="Left" Text="{loc:T prompt.saved}" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{StaticResource MutedTextBlock}"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Lewa kolumna: konfiguracja (gdy jest), potem koncept, który wypełnia resztę -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="SystemSection" Grid.Row="0" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock x:Name="SystemCounter" DockPanel.Dock="Right" Style="{StaticResource MutedTextBlock}"/>
                        <TextBlock Text="{loc:T prompt.config}" Style="{StaticResource SectionHeader}"/>
                    </DockPanel>
                    <TextBox x:Name="SystemBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Height="130"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             TextChanged="Box_TextChanged"/>
                    <TextBlock Text="{loc:T prompt.config.tip}" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0"/>
                </StackPanel>

                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="PromptCounter" DockPanel.Dock="Right" Style="{StaticResource MutedTextBlock}"/>
                    <TextBlock x:Name="PromptHeader" Style="{StaticResource SectionHeader}"
                               ToolTip="{loc:T prompt.concept.tip}"/>
                </DockPanel>
                <TextBox x:Name="PromptBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="14" MinHeight="140"
                         TextChanged="Box_TextChanged"/>
            </Grid>

            <!-- Prawa kolumna: opis obrazów i przebudowa; przy braku obu ta kolumna ma szerokość 0 (code-behind) -->
            <ScrollViewer x:Name="SidebarHost" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button x:Name="DescribeButton" Content="{loc:T prompt.describe}" Padding="10,2" HorizontalAlignment="Left" Margin="0,0,0,10"
                            Click="Describe_Click" Visibility="Collapsed"
                            ToolTip="{loc:T prompt.describe.tip}"/>

                    <StackPanel x:Name="RebuildSection">
                        <DockPanel>
                            <TextBlock x:Name="InstructionCounter" DockPanel.Dock="Right" Style="{StaticResource MutedTextBlock}"/>
                            <TextBlock Text="{loc:T prompt.technical}" Style="{StaticResource SectionHeader}"/>
                        </DockPanel>
                        <TextBox x:Name="InstructionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Box_TextChanged"
                                 ToolTip="{loc:T prompt.technical.tip}"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="RebuildButton" Content="{loc:T prompt.rewrite}" Padding="12,4" Margin="0,0,8,6" Click="Rebuild_Click"
                                    ToolTip="{loc:T prompt.rewrite.tip}"/>
                            <Button x:Name="UndoButton" Content="{loc:T prompt.undo}" Padding="12,4" Margin="0,0,8,6" Click="UndoRebuild_Click" IsEnabled="False"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button Content="{loc:T prompt.defaultInstruction}" Padding="12,4" Margin="0,0,0,6" Click="DefaultInstruction_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock x:Name="HistoryLabel" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource MutedTextBlock}"
                                       ToolTip="{loc:T prompt.context.tip}"/>
                            <Button x:Name="ClearHistoryButton" Content="{loc:T prompt.clearContext}" Padding="10,2" Click="ClearHistory_Click"
                                    Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                        <Expander x:Name="EnhancerHost" Header="{loc:T prompt.modelParams}" IsExpanded="False" Margin="0,8,0,0">
                            <views:EnhancerPanel Margin="0,4,0,0"/>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ClearButton" Content="{loc:T prompt.clearAll}" Padding="12,0" Margin="0,0,8,0" Click="Clear_Click"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="{loc:T common.cancel}" IsCancel="True" Width="90" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="{loc:T prompt.apply}" IsDefault="True" Width="90" Click="Apply_Click"
                        ToolTip="{loc:T prompt.hint}"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"
                       Style="{StaticResource MutedTextBlock}"/>
        </DockPanel>
    </Grid>
</Window>
