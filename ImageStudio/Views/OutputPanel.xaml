<UserControl x:Class="ImageStudio.Views.OutputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Zapisz jako..." Width="110" Margin="8,0,0,0"
                    Command="{Binding SaveImageAsCommand}"/>
            <Button DockPanel.Dock="Right" Content="Kopiuj" Width="90" Margin="8,0,0,0"
                    Command="{Binding CopyImageCommand}"/>
            <Button DockPanel.Dock="Right" Content="100%" Width="60" Margin="8,0,0,0"
                    Command="{Binding ResetZoomCommand}"/>
            <TextBlock Text="{Binding Zoom, StringFormat='Skala: {0:P0}'}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Slider Minimum="0.1" Maximum="4" Value="{Binding Zoom}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Source="{Binding Image}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
