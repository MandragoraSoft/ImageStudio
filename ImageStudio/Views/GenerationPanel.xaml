<UserControl x:Class="ImageStudio.Views.GenerationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <Expander Header="Konfiguracja (prompt systemowy: styl, technika, format)" IsExpanded="True">
                <TextBox Text="{Binding GenerateSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="70" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Część techniczna. AI wypełnia ją automatycznie przy ulepszaniu."/>
            </Expander>

            <TextBlock Text="Koncept (co ma być na obrazie)" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding GeneratePrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                     VerticalScrollBarVisibility="Auto"/>

            <Button Content="Ulepsz prompt AI" Margin="0,4,0,0"
                    Command="{Binding EnhanceGeneratePromptCommand}" ToolTip="Podrasuj prompt wybranym modelem tekstowym"/>
            <UniformGrid Columns="3" Margin="0,4,0,0">
                <Button Content="Cofnij" Margin="0,0,4,0"
                        Command="{Binding UndoEnhanceGeneratePromptCommand}" ToolTip="Przywróć prompt sprzed ulepszenia"/>
                <Button Content="Zapisz zestaw" Margin="0,0,4,0"
                        Command="{Binding SavePresetCommand}" ToolTip="Zapisz prompt, model i parametry jako zestaw"/>
                <Button Content="Zestawy..."
                        Command="{Binding OpenPresetsCommand}" ToolTip="Wczytaj lub zarządzaj zapisanymi zestawami"/>
            </UniformGrid>

            <Expander Header="Ustawienia ulepszania AI" Margin="0,8,0,0">
                <views:EnhancerPanel Margin="0,4,0,0"/>
            </Expander>

            <Expander Header="Filtry modeli" Margin="0,4,0,0">
                <views:ModelFilterBar Margin="0,4,0,0"/>
            </Expander>

            <TextBlock Text="Model" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}"
                      ItemTemplate="{StaticResource ModelItemTemplate}" Margin="0,0,0,6"/>

            <Expander Header="Parametry obrazu" Margin="0,0,0,6">
                <StackPanel Margin="0,4,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Seed" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <TextBox Grid.Column="1" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pusty = losowy. Liczba = powtarzalny wynik"/>
                        <TextBlock Grid.Column="2" Text="Jakość" VerticalAlignment="Center" Margin="10,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                  ToolTip="auto = nie wysyłamy parametru jakości"/>
                    </Grid>
                    <TextBlock Text="Negatywny prompt" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Czego nie chcesz w obrazie (działa, gdy model to obsługuje)"/>
                </StackPanel>
            </Expander>

            <Expander Header="Proporcje i rozmiar wyjścia" IsExpanded="True" Margin="0,0,0,10">
                <views:SizePanel Margin="0,4,0,0"/>
            </Expander>

            <Button Content="Generuj" Height="34" Command="{Binding GenerateCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
