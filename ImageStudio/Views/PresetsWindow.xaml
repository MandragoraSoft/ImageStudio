<Window x:Class="ImageStudio.Views.PresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="{loc:T presets.title}" Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Siatka zestawów -->
        <DataGrid ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T common.name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{loc:T common.type}" Binding="{Binding KindLabel}" Width="95"/>
                <DataGridTextColumn Header="{loc:T common.model}" Binding="{Binding Model, TargetNullValue='—'}" Width="150"/>
                <DataGridTextColumn Header="{loc:T presets.changed}" Binding="{Binding UpdatedLocal}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Podgląd zaznaczonego zestawu -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T common.name}" Style="{StaticResource SectionHeader}"/>
                <!-- Enter w nazwie zapisuje nazwę (a nie wczytuje zestawu przyciskiem domyślnym), gdy jest co zapisać -->
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SaveDetailsCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{loc:T common.description}" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                <Button Content="{loc:T presets.saveMeta}" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding SaveDetailsCommand}"/>

                <TextBlock Text="{loc:T presets.preview}" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{loc:T common.type}" Style="{StaticResource MutedTextBlock}"/>
                        <TextBlock Text="{Binding SelectedPreset.KindLabel, TargetNullValue='—'}"/>
                        <TextBlock Text="{loc:T common.model}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.Model, TargetNullValue='—'}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:T presets.size}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.SizeLabel, TargetNullValue='—'}"/>
                        <TextBlock Text="{loc:T presets.seedQuality}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.SeedText, Converter={x:Static loc:NullToLoc.Instance}, ConverterParameter=presets.random}"/>
                        <TextBlock Text="{Binding SelectedPreset.Quality, Converter={x:Static loc:NullToLoc.Instance}, ConverterParameter=presets.auto}"/>
                        <TextBlock Text="{loc:T presets.aiModel}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.EnhancerModel, TargetNullValue='—'}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:T presets.aiParams}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding SelectedPreset.Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Key, Mode=OneWay}"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding Value.Value, Mode=OneWay, StringFormat='{}{0:0.##}'}"/>
                                        <Run Text="{Binding Value.Enabled, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:T common.prompt}" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding SelectedPreset.Prompt, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <TextBlock Text="{loc:T gen.negative}" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,2"/>
                <TextBox Text="{Binding SelectedPreset.NegativePrompt, Mode=OneWay, TargetNullValue=''}" IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Akcje -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:T common.load}" Width="110" IsDefault="True" Command="{Binding LoadPresetCommand}"/>
            <Button Content="{loc:T common.remove}" Width="90" Margin="8,0,0,0" Command="{Binding DeletePresetCommand}"/>
            <Button Content="{loc:T presets.import}" Margin="8,0,0,0" Padding="10,2"
                    Command="{Binding ImportLegacyCommand}" ToolTip="{loc:T presets.import.tip}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource MutedTextBlock}"/>
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="2" Content="{loc:T common.close}" Width="110" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource SecondaryButton}"/>
    </Grid>
</Window>
