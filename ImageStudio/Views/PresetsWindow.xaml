<Window x:Class="ImageStudio.Views.PresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Title="Zestawy ustawień" Width="980" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Siatka zestawów -->
        <DataGrid ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding KindLabel}" Width="95"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model, TargetNullValue='—'}" Width="150"/>
                <DataGridTextColumn Header="Zmieniono" Binding="{Binding UpdatedLocal}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Podgląd zaznaczonego zestawu -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nazwa" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Opis" Style="{StaticResource SectionHeader}"/>
                <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                <Button Content="Zapisz nazwę i opis" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding SaveDetailsCommand}"/>

                <TextBlock Text="Podgląd ustawień" Style="{StaticResource SectionHeader}" Margin="0,16,0,4"/>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Typ" Style="{StaticResource MutedTextBlock}"/>
                        <TextBlock Text="{Binding SelectedPreset.KindLabel, TargetNullValue='—'}"/>
                        <TextBlock Text="Model" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.Model, TargetNullValue='—'}" TextWrapping="Wrap"/>
                        <TextBlock Text="Rozmiar" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.SizeLabel, TargetNullValue='—'}"/>
                        <TextBlock Text="Seed / jakość" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.SeedText, TargetNullValue='losowy'}"/>
                        <TextBlock Text="{Binding SelectedPreset.Quality, TargetNullValue='auto'}"/>
                        <TextBlock Text="Model AI" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SelectedPreset.EnhancerModel, TargetNullValue='—'}" TextWrapping="Wrap"/>
                        <TextBlock Text="Parametry AI" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"/>
                        <ItemsControl ItemsSource="{Binding SelectedPreset.Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Key, Mode=OneWay}"/>
                                        <Run Text=": "/>
                                        <Run Text="{Binding Value.Value, Mode=OneWay, StringFormat='{}{0:0.##}'}"/>
                                        <Run Text="{Binding Value.Enabled, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Prompt" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding SelectedPreset.Prompt, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="260" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                <TextBlock Text="Negatywny prompt" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,2"/>
                <TextBox Text="{Binding SelectedPreset.NegativePrompt, Mode=OneWay, TargetNullValue=''}" IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Akcje -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Wczytaj" Width="110" IsDefault="True" Command="{Binding LoadPresetCommand}"/>
            <Button Content="Usuń" Width="90" Margin="8,0,0,0" Command="{Binding DeletePresetCommand}"/>
            <Button Content="Importuj stare prompty" Margin="8,0,0,0" Padding="10,2"
                    Command="{Binding ImportLegacyCommand}" ToolTip="Zamienia prompts.json z poprzedniej wersji na zestawy"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource MutedTextBlock}"/>
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="2" Content="Zamknij" Width="110" IsCancel="True" HorizontalAlignment="Right"
                Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
    </Grid>
</Window>
