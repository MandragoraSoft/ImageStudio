<Window x:Class="ImageStudio.Views.PresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared"
        xmlns:local="clr-namespace:ImageStudio.Views"
        Style="{StaticResource WindowBase}"
        Title="{loc:T presets.title}" Width="1100" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:KindFilterLabelConverter x:Key="KindLabel"/>

        <!-- Kafelek proporcji jak w SizePanel (głównego okna): wybrany podświetlony akcentem -->
        <Style x:Key="AspectTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,4" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Szukanie i filtr rodzaju nad siatką -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                      ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource KindLabel}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{loc:T filter.search}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Siatka zestawów -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T common.name}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{loc:T common.type}" Binding="{Binding KindLabel}" Width="95"/>
                <DataGridTextColumn Header="{loc:T common.model}" Binding="{Binding Model, TargetNullValue='—'}" Width="150"/>
                <DataGridTextColumn Header="{loc:T presets.changed}" Binding="{Binding UpdatedLocal}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edycja zaznaczonego zestawu: pola podstawowe, potem zwijane sekcje (rozwinięta tylko Prompt) -->
        <ScrollViewer Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T common.name}" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:T presets.ai}" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButton}" Command="{Binding SuggestNameCommand}"
                            ToolTip="{loc:T presets.ai.name.tip}" Visibility="{Binding CanSuggest, Converter={StaticResource BoolToVis}}"/>
                    <!-- Enter w nazwie zapisuje zmiany (a nie wczytuje zestawu przyciskiem domyślnym), gdy jest co zapisać -->
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SaveDetailsCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <TextBlock Text="{loc:T common.description}" Style="{StaticResource SectionHeader}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:T presets.ai}" Padding="10,2" Margin="6,0,0,0" VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButton}" Command="{Binding SuggestDescriptionCommand}"
                            ToolTip="{loc:T presets.ai.description.tip}" Visibility="{Binding CanSuggest, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>

                <TextBlock Text="{loc:T common.type}" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SelectedPreset.KindLabel, TargetNullValue='—'}"/>

                <TextBlock Text="{loc:T common.model}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0"/>
                <views:ModelPicker HasFilters="True" ItemsSource="{Binding PickerView}" FiltersContext="{Binding PickerFilter}"
                                   SelectedItem="{Binding SelectedModelOption}"/>
                <TextBlock Text="{Binding ModelWarning}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}"/>

                <Expander x:Name="PromptExpander" Header="{loc:T common.prompt}" IsExpanded="True" Margin="0,8,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        <Button Content="{loc:T presets.editInEditor}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Style="{StaticResource SecondaryButton}" Command="{Binding EditInEditorCommand}"
                                Visibility="{Binding CanEditInEditor, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Expander>

                <Expander x:Name="SystemExpander" Header="{loc:T presets.systemPrompt}" Margin="0,8,0,0">
                    <TextBox Text="{Binding EditSystemPrompt, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="160" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                </Expander>

                <Expander x:Name="NegativeExpander" Header="{loc:T gen.negative}" Margin="0,8,0,0">
                    <TextBox Text="{Binding EditNegativePrompt, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>
                </Expander>

                <Expander x:Name="DetailsExpander" Margin="0,8,0,0">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:T presets.section.details}"/>
                            <TextBlock Text="{Binding DetailsSummary}" Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,4,0,0">
                        <ListBox ItemsSource="{Binding AspectPresets}" SelectedItem="{Binding SelectedAspect}"
                                 Background="Transparent" BorderThickness="0" Margin="0,0,0,6"
                                 ItemContainerStyle="{StaticResource AspectTile}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T presets.width}" Style="{StaticResource MutedTextBlock}"/>
                                <TextBox Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T presets.height}" Style="{StaticResource MutedTextBlock}"/>
                                <TextBox Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:T gen.seed}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" ToolTip="{loc:T gen.seed.tip}"/>
                        <TextBox Text="{Binding EditSeedText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T gen.seed.tip}"/>
                        <TextBlock Text="{loc:T gen.quality}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" ToolTip="{loc:T gen.quality.tip}"/>
                        <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding EditQuality}" ToolTip="{loc:T gen.quality.tip}"/>
                    </StackPanel>
                </Expander>

                <Expander x:Name="AssistExpander" Header="{loc:T presets.section.assist}" Margin="0,8,0,0">
                    <StackPanel Margin="0,4,0,0">
                        <views:ModelPicker Header="{loc:T enh.model}" HasFilters="True" ItemsSource="{Binding EnhancerPickerView}"
                                           FiltersContext="{Binding EnhancerPickerFilter}" SelectedItem="{Binding SelectedEnhancerOption}"/>
                        <TextBlock Text="{Binding EnhancerWarning}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource WarningBrush}"/>

                        <TextBlock Text="{loc:T prompt.technical}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" ToolTip="{loc:T prompt.technical.tip}"/>
                        <TextBox Text="{Binding EditEnhancerInstruction, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="{loc:T presets.aiParams}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding EditParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBox DockPanel.Dock="Right" Width="90" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Content="{Binding Key, Mode=OneWay}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Akcje: po lewej wczytanie i zarządzanie, po prawej autozapis, zapis i zamknięcie -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:T common.load}" Width="110" IsDefault="True" Command="{Binding LoadPresetCommand}"/>
            <Button Content="{loc:T common.remove}" Width="90" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding DeletePresetCommand}"/>
            <Button Content="{loc:T presets.duplicate}" Margin="8,0,0,0" Padding="10,2" Style="{StaticResource SecondaryButton}"
                    Command="{Binding DuplicatePresetCommand}"/>
            <Button Content="{loc:T presets.import}" Margin="8,0,0,0" Padding="10,2" Style="{StaticResource SecondaryButton}"
                    Command="{Binding ImportLegacyCommand}" ToolTip="{loc:T presets.import.tip}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource MutedTextBlock}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Zamknięcie też pyta o niezapisane zmiany (Closing w code-behind); IsCancel bez własnego Click, inaczej pytanie padałoby dwa razy -->
            <CheckBox Content="{loc:T presets.autoSave}" IsChecked="{Binding AutoSave}" ToolTip="{loc:T presets.autoSave.tip}"
                      VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="{loc:T presets.saveChanges}" Padding="12,0" Margin="0,0,8,0" Command="{Binding SaveDetailsCommand}"/>
            <Button Content="{loc:T common.close}" Width="90" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
