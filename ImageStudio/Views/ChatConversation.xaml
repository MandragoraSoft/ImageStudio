<UserControl x:Class="ImageStudio.Views.ChatConversation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:ImageStudio.Services;assembly=ImageStudio.Providers.Core"
             AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
    <!-- Rozmowa i pole wpisywania z obrazami (DataContext = ChatViewModel); pliki można przeciągnąć na cały panel -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type svc:ChatMessage}">
            <Border x:Name="Bubble" Margin="0,0,0,8" Padding="10,6" CornerRadius="8" MaxWidth="680"
                    HorizontalAlignment="Left" BorderThickness="1"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" Style="{StaticResource MutedTextBlock}"/>
                    <!-- Obrazy dołączone do wiadomości -->
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Preview}" MaxWidth="260" MaxHeight="200" Stretch="Uniform"
                                       Margin="0,2,6,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- TextBox tylko do odczytu, żeby dało się zaznaczać i kopiować fragmenty odpowiedzi -->
                    <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Padding="0" Background="Transparent"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding Messages}"/>
                </ScrollViewer>
                <TextBlock Text="Napisz wiadomość poniżej, aby zacząć rozmowę. Obrazy możesz dodać przyciskiem, wkleić (Ctrl+V) albo przeciągnąć na panel."
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <!-- Obrazy czekające na wysłanie -->
            <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="64" Height="64" Margin="0,0,6,6">
                            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                            <Button Content="×" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ImageWarning}" TextWrapping="Wrap" Foreground="OrangeRed"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Wyślij" Width="90" Margin="8,0,0,0" VerticalAlignment="Stretch"
                        Command="{Binding SendCommand}" ToolTip="Ctrl+Enter"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Dodaj obraz..." Padding="10,3" Margin="0,0,6,0" Command="{Binding AttachImagesCommand}"/>
                <Button Content="Wklej obraz" Padding="10,3" Command="{Binding PasteImageCommand}"
                        ToolTip="Wkleja obraz ze schowka (Ctrl+V w polu wiadomości też to robi)"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
