<UserControl x:Class="ImageStudio.Views.ChatConversation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
             xmlns:svc="clr-namespace:ImageStudio.Services;assembly=ImageStudio.Providers.Core"
             xmlns:local="clr-namespace:ImageStudio.Views"
             AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
    <!-- Rozmowa i pole wpisywania z obrazami (DataContext = ChatViewModel); pliki można przeciągnąć na cały panel -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type svc:ChatMessage}">
            <Border x:Name="Bubble" Margin="0,0,0,8" Padding="10,6" CornerRadius="8" MaxWidth="680"
                    HorizontalAlignment="Left" BorderThickness="1"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" Style="{StaticResource MutedTextBlock}"/>
                    <!-- Podgląd rozumowania modelu (jeśli odpowiedź je zawiera); domyślnie zwinięty -->
                    <Expander Header="{loc:T chat.reasoningHeader}" FontSize="12" Margin="0,2,0,2"
                              Visibility="{Binding HasReasoning, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Reasoning, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontStyle="Italic"
                                 BorderThickness="0" Padding="4" Background="Transparent" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Expander>
                    <!-- Obrazy dołączone do wiadomości -->
                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Preview}" MaxWidth="260" MaxHeight="200" Stretch="Uniform"
                                       Margin="0,2,6,4" Cursor="Hand" ToolTip="{loc:T chat.image.open}">
                                    <Image.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Image.InputBindings>
                                </Image>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Odpowiedź modelu jako Markdown (kod, listy, pogrubienia); tekst użytkownika i narzędzi zostaje surowy.
                         Oba pola są tylko do odczytu, żeby dało się zaznaczać i kopiować fragmenty -->
                    <local:MarkdownView>
                        <local:MarkdownView.Style>
                            <Style TargetType="local:MarkdownView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Wiązanie tekstu tylko dla asystenta: ukryty widok nie parsuje tekstu użytkownika ani wyników narzędzi -->
                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Markdown" Value="{Binding DisplayText, Mode=OneWay}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:MarkdownView.Style>
                    </local:MarkdownView>
                    <TextBox Text="{Binding DisplayText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Padding="0" Background="Transparent">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- Zwinięty długi wynik: kilka pierwszych linii, reszta pod przyciskiem "Rozwiń" -->
                                    <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                        <Setter Property="MaxHeight" Value="64"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Długi wynik narzędzia (np. JSON): zwijanie i rozwijanie; "Zwijaj zawsze" zapamiętuje wybór i znika -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsLong, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T chat.long.label}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource MutedTextBlock}"/>
                        <TextBlock Text="{Binding Length, StringFormat={}{0:N0}}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextBlock}"/>
                        <TextBlock Text="{loc:T chat.long.chars}" FontSize="11" Margin="3,0,8,0" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextBlock}"/>
                        <Button Content="{loc:T chat.long.collapse}" Padding="8,1" Margin="0,0,6,0"
                                Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T chat.long.expand}" Padding="8,1" Margin="0,0,6,0" Visibility="Collapsed"
                                Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Collapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T chat.long.always}" Padding="8,1" Style="{StaticResource SecondaryButton}" ToolTip="{loc:T chat.long.always.tip}"
                                Command="{Binding DataContext.CollapseAlwaysCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding DataContext.AskCollapse, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <!-- Zużycie tokenów tego wywołania: wejście, wyjście i z cache -->
                    <TextBlock Text="{Binding UsageText}" FontSize="11" Margin="0,4,0,0" Style="{StaticResource MutedTextBlock}"
                               ToolTip="{loc:T chat.tokens.tip}"
                               Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <!-- Lista wirtualizowana: w drzewie są tylko dymki widoczne na ekranie (długa rozmowa to setki pól RichTextBox).
                     Przewijanie w pikselach, bo dymki mają różną wysokość -->
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" ScrollViewer.ScrollChanged="Messages_ScrollChanged"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.VirtualizationMode="Standard" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="Scroll" Focusable="False" VerticalScrollBarVisibility="Auto" Padding="12" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- Znacznik sesji incognito: rozmowa nie jest zapisywana -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="10" IsHitTestVisible="False"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding IsIncognito, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T chat.incognito.banner}" FontSize="11"/>
                </Border>
                <TextBlock Text="{loc:T chat.empty}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <!-- Zgoda na narzędzie: pytanie w oknie czatu (raz, w tej rozmowie, na stałe albo odmowa); pętla narzędzi czeka na odpowiedź -->
            <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderSoftBrush}" Background="{DynamicResource AccentSoftBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PendingApproval}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T chat.approval.title}"/>
                        <TextBlock Text="{Binding PendingApproval.Call.Name}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding PendingApproval.Arguments, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Padding="0,2" Background="Transparent" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                             Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{loc:T chat.approval.once}" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding AnswerApprovalCommand}" CommandParameter="Once"/>
                        <Button Content="{loc:T chat.approval.session}" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding AnswerApprovalCommand}" CommandParameter="Session" ToolTip="{loc:T chat.approval.session.tip}"/>
                        <Button Content="{loc:T chat.approval.always}" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding AnswerApprovalCommand}" CommandParameter="Always" ToolTip="{loc:T chat.approval.always.tip}"/>
                        <Button Content="{loc:T chat.approval.deny}" Padding="10,3"
                                Command="{Binding AnswerApprovalCommand}" CommandParameter="Deny"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Obrazy czekające na wysłanie -->
            <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="64" Height="64" Margin="0,0,6,6">
                            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                            <Button Content="×" Width="18" Height="18" Padding="0" MinWidth="0" MinHeight="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding ImageWarning}" TextWrapping="Wrap" Foreground="OrangeRed"/>
            <TextBlock Text="{Binding ToolsWarning}" TextWrapping="Wrap" Foreground="OrangeRed"/>

            <!-- Zajętość okna kontekstowego: pasek (gdy katalog podaje limit) i tekst; od 75% ostrzegawczo, od 90% mocniej -->
            <Grid Margin="0,2,0,4" ToolTip="{loc:T chat.context.tip}" Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Height="4" Maximum="100" Value="{Binding ContextBarValue, Mode=OneWay}" VerticalAlignment="Center"
                             Visibility="{Binding HasContextLimit, Converter={StaticResource BoolToVis}}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContextLevel}" Value="warn">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ContextLevel}" Value="critical">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Grid.Column="1" Text="{Binding ContextText}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContextLevel}" Value="warn">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ContextLevel}" Value="critical">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_PreviewKeyDown">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!-- W trakcie odpowiedzi "Wyślij" ustępuje miejsca "Stop" (przerywa żądanie; napłynięty tekst zostaje) -->
                <Button Grid.Column="1" Content="{loc:T chat.send}" Width="90" Margin="8,0,0,0" VerticalAlignment="Stretch"
                        Command="{Binding SendCommand}" ToolTip="Ctrl+Enter">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1" Content="{loc:T chat.stop}" Width="90" Margin="8,0,0,0" VerticalAlignment="Stretch"
                        Command="{Binding StopCommand}" Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"
                        ToolTip="{loc:T chat.stop.tip}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="{loc:T chat.addImage}" Padding="10,3" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding AttachImagesCommand}"/>
                <Button Content="{loc:T chat.pasteImage}" Padding="10,3" Style="{StaticResource SecondaryButton}" Command="{Binding PasteImageCommand}"
                        ToolTip="{loc:T chat.pasteImage.tip}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
