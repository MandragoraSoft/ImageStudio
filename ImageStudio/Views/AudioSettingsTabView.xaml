<UserControl x:Class="ImageStudio.Views.AudioSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,8,0">
            <TextBlock Text="Wejście (mikrofon)" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Name"/>

            <TextBlock Text="Wyjście (głośniki, słuchawki)" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" DisplayMemberPath="Name"/>

            <TextBlock Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Urządzenia dotyczą zakładki Głos: nagrywanie z mikrofonu i odtwarzanie nagrań. Domyślne urządzenie systemu zmienia się razem z ustawieniami Windows. Przy wirtualnych urządzeniach (np. SteelSeries Sonar, Steam Streaming) wybierz tu to, na którym faktycznie słychać dźwięk."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
