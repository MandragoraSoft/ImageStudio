<UserControl x:Class="ImageStudio.Views.AudioSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <UserControl.Resources>
        <DataTemplate x:Key="AudioDeviceTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,8,0">
            <TextBlock Text="{loc:T audio.input}" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" ItemTemplate="{StaticResource AudioDeviceTemplate}"/>

            <TextBlock Text="{loc:T audio.output}" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" ItemTemplate="{StaticResource AudioDeviceTemplate}"/>

            <TextBlock Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="{loc:T audio.note}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
