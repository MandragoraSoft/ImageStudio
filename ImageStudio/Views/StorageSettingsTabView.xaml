<UserControl x:Class="ImageStudio.Views.StorageSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,8,0">
            <TextBlock Text="{loc:T storage.plugin}" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ItemsControl ItemsSource="{Binding Selected.Fields}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionHeader}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{loc:T storage.browse}" Margin="6,0,0,0" Padding="10,2"
                                        Click="Browse_Click" Style="{StaticResource SecondaryButton}"/>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="{loc:T storage.note}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
