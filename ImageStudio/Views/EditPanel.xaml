<UserControl x:Class="ImageStudio.Views.EditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <Expander Header="Obrazy referencyjne (pierwszy = podstawowy)" IsExpanded="True">
                <StackPanel Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Dodaj..." Width="90" Margin="0,0,6,0" Command="{Binding AddReferencesCommand}"/>
                        <Button Content="Wyczyść" Width="90" Command="{Binding ClearReferencesCommand}"/>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Dodaj z linku" Width="110" Margin="6,0,0,0"
                                Command="{Binding AddReferenceFromUrlCommand}"/>
                        <TextBox Text="{Binding ReferenceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Adres http(s) obrazu JPG, PNG lub WEBP"/>
                    </DockPanel>

                    <ListBox ItemsSource="{Binding References}" Height="110" Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Source}">
                                    <Button DockPanel.Dock="Right" Content="×" Width="26" Padding="0" Margin="6,0,0,0"
                                            Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                            Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Długie linki są skracane z "..." na końcu; pełny adres w podpowiedzi -->
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Podgląd podstawowego obrazu zachowuje proporcje (Uniform) -->
                    <Border Height="200" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                            Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,0,0,4">
                        <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="6"/>
                    </Border>
                </StackPanel>
            </Expander>

            <Expander Header="Konfiguracja (prompt systemowy: styl, technika, format)" IsExpanded="True">
                <TextBox Text="{Binding EditSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="70" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Część techniczna. AI wypełnia ją automatycznie przy ulepszaniu."/>
            </Expander>

            <TextBlock Text="Koncept edycji (co ma się zmienić)" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     VerticalScrollBarVisibility="Auto"/>

            <Button Content="Ulepsz prompt AI" Margin="0,4,0,0"
                    Command="{Binding EnhanceEditPromptCommand}" ToolTip="Podrasuj prompt wybranym modelem tekstowym"/>
            <UniformGrid Columns="3" Margin="0,4,0,0">
                <Button Content="Cofnij" Margin="0,0,4,0"
                        Command="{Binding UndoEnhanceEditPromptCommand}" ToolTip="Przywróć prompt sprzed ulepszenia"/>
                <Button Content="Zapisz zestaw" Margin="0,0,4,0"
                        Command="{Binding SavePresetCommand}" ToolTip="Zapisz prompt, model i parametry jako zestaw"/>
                <Button Content="Zestawy..."
                        Command="{Binding OpenPresetsCommand}" ToolTip="Wczytaj lub zarządzaj zapisanymi zestawami"/>
            </UniformGrid>

            <Expander Header="Ustawienia ulepszania AI" Margin="0,8,0,0">
                <views:EnhancerPanel Margin="0,4,0,0"/>
            </Expander>

            <Expander Header="Filtry modeli" Margin="0,4,0,0">
                <views:ModelFilterBar Margin="0,4,0,0"/>
            </Expander>

            <TextBlock Text="Model edycji" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding EditModelsView}" SelectedItem="{Binding SelectedEditModel}"
                      ItemTemplate="{StaticResource ModelItemTemplate}" Margin="0,0,0,6"/>

            <Expander Header="Proporcje i rozmiar wyjścia" IsExpanded="True" Margin="0,0,0,6">
                <StackPanel>
                    <views:SizePanel Margin="0,4,0,0"/>
                    <TextBlock Text="Endpoint edycji nie przyjmuje rozmiaru: wynik dopasowujemy do proporcji lokalnie."
                               TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>

            <Button Content="Edytuj" Height="34" Margin="0,6,0,0" Command="{Binding EditCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
