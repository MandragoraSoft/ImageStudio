<UserControl x:Class="ImageStudio.Views.EditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <TextBlock Text="Obraz źródłowy" Style="{StaticResource SectionHeader}"/>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Wybierz..." Width="90" Margin="8,0,0,0"
                        Command="{Binding PickSourceCommand}"/>
                <TextBlock Text="{Binding SourceImagePath, FallbackValue='(nie wybrano)', TargetNullValue='(nie wybrano)'}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Podgląd źródła zachowuje proporcje (Uniform) -->
            <Border Height="240" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Margin="0,0,0,12">
                <Image Source="{Binding SourceImage}" Stretch="Uniform" Margin="6"/>
            </Border>

            <TextBlock Text="Prompt edycji" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                     VerticalScrollBarVisibility="Auto"/>

            <views:ModelFilterBar Margin="0,10,0,0"/>

            <TextBlock Text="Model edycji" Style="{StaticResource SectionHeader}"/>
            <ComboBox ItemsSource="{Binding EditModelsView}" SelectedItem="{Binding SelectedEditModel}"
                      ItemTemplate="{StaticResource ModelItemTemplate}" Margin="0,0,0,10"/>

            <TextBlock Text="Wymiary wyjścia dobiera model edycji (proporcje zgodne z obrazem źródłowym)."
                       TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,12"/>

            <Button Content="Edytuj" Height="34" Command="{Binding EditCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
