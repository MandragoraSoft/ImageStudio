<Window x:Class="ImageStudio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="{loc:T about.title}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="28">
        <Image Source="pack://application:,,,/ImageStudio;component/Assets/AppIcon.ico"
               Width="64" Height="64" HorizontalAlignment="Center"/>
        <TextBlock Text="ImageStudio" FontSize="26" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0">
            <Run Text="{loc:T about.version}"/><Run Text="{Binding Version, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{loc:T about.description}" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,20,0,0"/>
        <Button Content="{loc:T common.close}" IsCancel="True" MinWidth="100"
                HorizontalAlignment="Center" Margin="0,24,0,0"/>
    </StackPanel>
</Window>
