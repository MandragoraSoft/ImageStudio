<Window x:Class="ImageStudio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        xmlns:vm="clr-namespace:ImageStudio.ViewModels"
        xmlns:views="clr-namespace:ImageStudio.Views"
        Style="{StaticResource WindowBase}"
        Title="{loc:T settings.title}" Width="500" Height="640" MinHeight="420"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Widok zakładki wybierany po typie jej ViewModelu (ISettingsTab); nowa zakładka = ViewModel + widok + wpis tutaj.
         Brak wpisu wykrywa SettingsWindow.EnsureTabViews przed otwarciem okna -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AppSettingsTab}">
            <views:AppSettingsTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioSettingsTab}">
            <views:AudioSettingsTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageSettingsTab}">
            <views:StorageSettingsTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpSettingsTab}">
            <views:McpSettingsTabView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProviderSettingsTab}">
            <views:ProviderSettingsTabView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16" IsEnabled="{Binding CanEdit}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="90" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button Content="{loc:T common.save}" IsDefault="True" Width="90" Click="Save_Click"/>
        </StackPanel>

        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </DockPanel>
</Window>
