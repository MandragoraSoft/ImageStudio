<Window x:Class="ImageStudio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageStudio.ViewModels"
        xmlns:views="clr-namespace:ImageStudio.Views"
        Style="{StaticResource WindowBase}"
        Title="Ustawienia" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Komponent konfiguracji wybierany po typie ViewModelu providera -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:UberLlmSettingsViewModel}">
            <views:UberLlmSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpenRouterSettingsViewModel}">
            <views:OpenRouterSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpenAiSettingsViewModel}">
            <views:OpenAiSettingsView/>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Dostawca AI" Style="{StaticResource SectionHeader}"/>
        <ComboBox ItemsSource="{Binding Providers}" SelectedValuePath="Id" SelectedValue="{Binding SelectedProvider}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Konfiguracja aktywnego providera -->
        <ContentControl Content="{Binding ActiveProvider}" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding ActiveProvider.EnvNotice}" TextWrapping="Wrap" Foreground="OrangeRed"/>

        <TextBlock Text="Lista modeli tego dostawcy" Style="{StaticResource SectionHeader}"/>
        <CheckBox Content="Pokazuj tylko preferowane (odznaczone = wszystkie)"
                  IsChecked="{Binding ActiveProvider.PreferredOnly}"
                  ToolTip="Preferowane wybierasz w oknie „Przeglądaj modele” obok filtrów. Pusta lista preferowanych pokazuje wszystkie modele."/>

        <views:ModelPicker Header="Domyślny model tekstowy dostawcy"
                           ItemsSource="{Binding ActiveProvider.TextModels}"
                           SelectedItem="{Binding ActiveProvider.DefaultTextModel}"/>
        <TextBlock Text="Ulepszanie promptów, czat i nazwy zestawów. Pełna lista modeli jest widoczna dla aktywnego dostawcy."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}"/>

        <TextBlock Text="Maksymalny długi bok obrazu źródłowego (px)" Style="{StaticResource SectionHeader}"/>
        <TextBox Text="{Binding MaxSide, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>

        <TextBlock Text="Motyw" Style="{StaticResource SectionHeader}"/>
        <ComboBox ItemsSource="{Binding Themes}" SelectedValuePath="Code" SelectedValue="{Binding SelectedTheme}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Klucze są szyfrowane (DPAPI) dla bieżącego konta Windows. Nie trafiają do plików projektu ani do repozytorium."
                   TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Anuluj" IsCancel="True" Width="90" Margin="0,0,8,0"
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Content="Zapisz" IsDefault="True" Width="90" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
