<Window x:Class="ImageStudio.Views.ModelBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Title="Przeglądaj modele" Width="940" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Szukaj po nazwie lub opisie modelu"/>
            <CheckBox Grid.Column="1" Content="Tylko preferowane" IsChecked="{Binding OnlyPreferred}"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Filtry: typ, dostawca modelu, wejście obrazowe, NSFW -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Typ:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" Width="130" Margin="0,0,14,0"/>
            <TextBlock Text="Dostawca:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
            <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" Width="150" Margin="0,0,14,0"/>
            <CheckBox Content="Przyjmuje obraz" IsChecked="{Binding AcceptsImageOnly}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox Content="Ukryj NSFW" IsChecked="{Binding HideNsfw}" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="★" Width="40"
                                        Binding="{Binding IsPreferred, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Option.Id}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dostawca" Binding="{Binding Option.OwnedBy}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding Kinds}" Width="150" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Możliwości" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Option}" ContentTemplate="{StaticResource ModelIconsTemplate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Cena" Binding="{Binding Option.PriceText}" Width="110" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Opis zaznaczonego modelu -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,8,0,0" Height="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Selected.Description, TargetNullValue='Zaznacz model, aby zobaczyć opis.'}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource MutedTextBlock}"/>
            <Button Content="Zamknij" IsDefault="True" IsCancel="True" Width="90" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
