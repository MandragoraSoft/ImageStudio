<Window x:Class="ImageStudio.Views.ModelBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="{loc:T browser.title}" Width="940" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="{loc:T browser.search.tip}"/>
            <CheckBox Grid.Column="1" Content="{loc:T browser.preferred}" IsChecked="{Binding OnlyPreferred}"
                      VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Filtry: typ, dostawca modelu, wejście obrazowe, NSFW -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:T browser.type}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" Width="130" Margin="0,0,14,0"/>
            <TextBlock Text="{loc:T filter.provider}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
            <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}" Width="150" Margin="0,0,14,0"/>
            <CheckBox Content="{loc:T filter.image}" IsChecked="{Binding AcceptsImageOnly}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox Content="{loc:T filter.nsfw}" IsChecked="{Binding HideNsfw}" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="★" Width="40"
                                        Binding="{Binding IsPreferred, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="{loc:T common.model}" Binding="{Binding Option.Id}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:T common.provider}" Binding="{Binding Option.OwnedBy}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="{loc:T common.type}" Binding="{Binding Kinds}" Width="150" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="{loc:T browser.capabilities}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Option}" ContentTemplate="{StaticResource ModelIconsTemplate}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:T browser.price}" Binding="{Binding Option.PriceText}" Width="110" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Opis zaznaczonego modelu -->
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,8,0,0" Height="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Selected.Description, Converter={x:Static loc:NullToLoc.Instance}, ConverterParameter=browser.noSelection}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Style="{StaticResource MutedTextBlock}"/>
            <Button Content="{loc:T common.close}" IsDefault="True" IsCancel="True" Width="90" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
