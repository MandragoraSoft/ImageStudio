<Window x:Class="ImageStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gen="clr-namespace:ImageStudio.Tabs.Generate;assembly=ImageStudio.Tabs.Generate"
        xmlns:edit="clr-namespace:ImageStudio.Tabs.Edit;assembly=ImageStudio.Tabs.Edit"
        xmlns:video="clr-namespace:ImageStudio.Tabs.Video;assembly=ImageStudio.Tabs.Video"
        xmlns:chat="clr-namespace:ImageStudio.Tabs.Chat;assembly=ImageStudio.Tabs.Chat"
        xmlns:views="clr-namespace:ImageStudio.Views"
        xmlns:shared="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared"
        Style="{StaticResource WindowBase}"
        Title="ImageStudio" Height="800" Width="1220" MinHeight="560" MinWidth="860">
    <!-- Skróty: Ctrl+Enter = akcja aktywnej zakładki (Generuj / Edytuj), Ctrl+S = zapis wyniku -->
    <!-- Widok zakładki wybierany po jej typie; nowa zakładka = IMainTab + widok + wpis tutaj -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type gen:GenerateTab}">
            <gen:GenerationPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type edit:EditTab}">
            <edit:EditPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type video:VideoTab}">
            <video:VideoPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type chat:ChatTab}">
            <chat:ChatPanel DataContext="{Binding Content}"/>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding RunActiveTabCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveImageAsCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu klasyczne: te same polecenia co przyciski w panelach -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Zapisz jako..." InputGestureText="Ctrl+S" Command="{Binding SaveImageAsCommand}"/>
                <MenuItem Header="_Kopiuj obraz" Command="{Binding CopyImageCommand}"/>
                <MenuItem Header="_Wyczyść wynik" Command="{Binding ClearResultCommand}"/>
                <Separator/>
                <MenuItem Header="Wyjś_cie" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Zestawy">
                <MenuItem Header="_Zapisz zestaw" Command="{Binding SavePresetCommand}"/>
                <MenuItem Header="Z_estawy..." Command="{Binding OpenPresetsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Modele">
                <MenuItem Header="_Przeglądaj modele..." Command="{Binding OpenModelBrowserCommand}"/>
                <MenuItem Header="_Odśwież listy modeli" Command="{Binding ReloadModelsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Narzędzia">
                <MenuItem Header="_Ustawienia..." Command="{Binding OpenSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="Wyczyść _galerię" Command="{Binding ClearGalleryCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Stopka: status, aktywny dostawca i spinner z opisem trwającej operacji sieciowej -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Margin="12,0">
                <TextBlock Text="{Binding ProviderName, StringFormat='Dostawca: {0}'}" Style="{StaticResource MutedTextBlock}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" MinWidth="220">
                <StackPanel Orientation="Horizontal" Visibility="{Binding Activity.IsActive, Converter={StaticResource BoolToVis}}">
                    <shared:Spinner Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Activity.Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="280" views:WindowMemory.ColumnKey="MainWindow.LeftPanel"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT: zakładki z opcjami, metryczka modelu pod nimi -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zakładki wstrzyknięte (IMainTab): MainWindow.xaml.cs tworzy je raz z DataTemplate wg typu zakładki -->
                <TabControl x:Name="MainTabs" Grid.Row="0" SelectedIndex="{Binding ActiveTab}"/>

                <views:ModelMetricsPanel Grid.Row="1" Margin="0,8,0,0"
                                         Visibility="{Binding IsNotChatTab, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderSoftBrush}"/>

            <!-- OUTPUT: wynik z zachowaniem proporcji; w czasie operacji sieciowej okno odpowiedzi jest przyciemnione -->
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Activity.DimsResponse}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:OutputPanel Visibility="{Binding IsNotChatTab, Converter={StaticResource BoolToVis}}"/>
                <Grid Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVis}}">
                    <views:ChatConversation DataContext="{Binding Chat}"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
