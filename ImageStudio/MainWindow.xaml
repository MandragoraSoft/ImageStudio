<Window x:Class="ImageStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageStudio.ViewModels"
        xmlns:views="clr-namespace:ImageStudio.Views"
        Style="{StaticResource WindowBase}"
        Title="ImageStudio" Height="800" Width="1220" MinHeight="560" MinWidth="860">
    <!-- Skróty: Ctrl+Enter = akcja aktywnej zakładki (Generuj / Edytuj), Ctrl+S = zapis wyniku -->
    <!-- Widok zakładki wybierany po jej typie; nowa zakładka = IMainTab + widok + wpis tutaj -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GenerateTab}">
            <views:GenerationPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditTab}">
            <views:EditPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoTab}">
            <views:VideoPanel DataContext="{Binding Content}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatTab}">
            <views:ChatPanel DataContext="{Binding Content}"/>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding RunActiveTabCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveImageAsCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" MinWidth="280" views:WindowMemory.ColumnKey="MainWindow.LeftPanel"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT: zakładki z opcjami, metryczka modelu pod nimi -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zakładki wstrzyknięte (IMainTab): MainWindow.xaml.cs tworzy je raz z DataTemplate wg typu zakładki -->
                <TabControl x:Name="MainTabs" Grid.Row="0" SelectedIndex="{Binding ActiveTab}"/>

                <views:ModelMetricsPanel Grid.Row="1" Margin="0,8,0,0"
                                         Visibility="{Binding IsNotChatTab, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderSoftBrush}"/>

            <!-- OUTPUT: wynik z zachowaniem proporcji -->
            <views:OutputPanel Grid.Column="2" Visibility="{Binding IsNotChatTab, Converter={StaticResource BoolToVis}}"/>
            <Grid Grid.Column="2" Visibility="{Binding IsChatTab, Converter={StaticResource BoolToVis}}">
                <views:ChatConversation DataContext="{Binding Chat}"/>
            </Grid>
        </Grid>

        <!-- Pasek stanu -->
        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Ustawienia..." Padding="10,2" Margin="0,0,12,0"
                    Command="{Binding OpenSettingsCommand}"/>
            <ProgressBar Grid.Column="2" IsIndeterminate="True" Height="6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>
