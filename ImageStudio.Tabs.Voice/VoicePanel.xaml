<UserControl x:Class="ImageStudio.Tabs.Voice.VoicePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared">
    <!-- DataContext = VoiceViewModel. Wyniki (odtwarzanie, zapis) są w prawym panelu okna głównego -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <Expander Header="Mowa z tekstu" IsExpanded="True">
                <StackPanel Margin="0,4,0,0">
                    <TextBox Text="{Binding SpeechText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="110" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>

                    <views:ModelPicker Header="Model mowy" ReloadCommand="{Binding ReloadModelsCommand}"
                                       ItemsSource="{Binding SpeechModels}" SelectedItem="{Binding SelectedSpeechModel}"/>

                    <TextBlock Text="Głos" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"/>

                    <TextBlock Text="{Binding Speed, StringFormat='Prędkość: {0:0.0}×'}" Margin="0,8,0,0"/>
                    <Slider Minimum="0.5" Maximum="2" Value="{Binding Speed}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

                    <TextBlock Text="Format" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}"/>

                    <TextBlock Text="{Binding SpeechEstimateLabel}" Style="{StaticResource MutedTextBlock}"
                               TextWrapping="Wrap" Margin="0,10,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Generuj mowę" Height="34" Command="{Binding SynthesizeCommand}"/>
                        <Button Grid.Column="1" Content="Anuluj" Height="34" Margin="6,0,0,0" Padding="14,0"
                                Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Header="Rozpoznawanie mowy" IsExpanded="True" Margin="0,10,0,0">
                <StackPanel Margin="0,4,0,0">
                    <Button Content="{Binding RecordButtonText}" Height="34" Command="{Binding ToggleRecordingCommand}"/>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding RecordLevel}" Height="6" Margin="0,6,0,0"
                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding RecordSeconds, StringFormat='Nagrywanie: {0} s'}" Style="{StaticResource MutedTextBlock}"
                               Margin="0,4,0,0" Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="Mikrofon" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" DisplayMemberPath="Name"/>

                    <TextBlock Text="Albo plik" Style="{StaticResource SectionHeader}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Wybierz..." Padding="12,6" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButton}" Command="{Binding PickAudioCommand}"/>
                        <TextBlock Text="{Binding AudioFileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding AudioPath}"/>
                    </DockPanel>

                    <views:ModelPicker Header="Model rozpoznawania" ReloadCommand="{Binding ReloadModelsCommand}"
                                       ItemsSource="{Binding TranscriptionModels}" SelectedItem="{Binding SelectedTranscriptionModel}"/>

                    <TextBlock Text="Język (kod, np. pl; puste = automatycznie)" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Podpowiedź (nazwy własne, słowa)" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding TranscriptionHint, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="44"
                             AcceptsReturn="True"/>

                    <TextBlock Text="{Binding TranscriptionPriceLabel}" Style="{StaticResource MutedTextBlock}"
                               TextWrapping="Wrap" Margin="0,10,0,10"/>
                    <Button Content="Rozpoznaj tekst" Height="34" Command="{Binding TranscribeCommand}"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
