<UserControl x:Class="ImageStudio.Views.ModelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization"
             xmlns:vm="clr-namespace:ImageStudio.ViewModels"
             xmlns:views="clr-namespace:ImageStudio.Views"
             x:Name="Picker">
    <!-- Wspólny selektor modelu: akordeon z nagłówkiem = wybrany model, lista modeli z dowolnego źródła
         (ModelOption lub tekst) i opcjonalny panel filtrów (HasFilters; filtry biorą DataContext z rodzica) -->
    <UserControl.Resources>
        <!-- Nagłówek akordeonu rozciągnięty na całą szerokość (domyślny szablon Expandera zwęża go do treści),
             dzięki czemu cena modelu stoi przy prawej krawędzi, jak w liście -->
        <Style x:Key="PickerExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource ControlBrush}" BorderThickness="1" CornerRadius="4"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" Padding="8,5" MinHeight="30">
                                            <DockPanel LastChildFill="True">
                                                <Path x:Name="Arrow" DockPanel.Dock="Left" Data="M 0 0 L 4 4 L 8 0 Z" VerticalAlignment="Center"
                                                      Fill="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:ModelOption}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModelItemTemplate}"/>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Header, ElementName=Picker}" Style="{StaticResource SectionHeader}"/>
        <Expander x:Name="Accordion" Style="{StaticResource PickerExpander}" HorizontalContentAlignment="Stretch" FontWeight="Normal" Margin="0,0,0,6"
                  Expanded="Accordion_Expanded">
            <Expander.Header>
                <Grid>
                    <ContentControl Content="{Binding SelectedItem, ElementName=Picker}" HorizontalContentAlignment="Stretch"/>
                    <!-- Bez wybranego modelu nagłówek mówi, co zrobić (pusty pasek wyglądał jak błąd) -->
                    <TextBlock Text="{loc:T picker.none}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem, ElementName=Picker}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Expander.Header>
            <StackPanel Margin="0,4,0,0">
                <DockPanel Margin="0,0,0,4">
                    <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="{loc:T picker.reload}" Padding="10,3" Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ReloadCommand, ElementName=Picker}"
                            ToolTip="{loc:T picker.reload.tip}"/>
                    <ToggleButton x:Name="FiltersToggle" Content="{loc:T filter.title}" Padding="10,3" HorizontalAlignment="Left"
                                  Style="{StaticResource FilterToggleButton}"
                                  Visibility="{Binding HasFilters, ElementName=Picker, Converter={StaticResource BoolToVis}}"/>
                </DockPanel>
                <views:ModelFilterBar x:Name="FilterBar" Margin="0,0,0,4"
                                      ModelsSource="{Binding ItemsSource, ElementName=Picker}" ActiveProvider="{Binding SelectedProvider}"
                                      Visibility="{Binding IsChecked, ElementName=FiltersToggle, Converter={StaticResource BoolToVis}}"/>
                <ListBox x:Name="List" MaxHeight="260" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding ItemsSource, ElementName=Picker}"
                         SelectedItem="{Binding SelectedItem, ElementName=Picker, Mode=OneWay}"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp" PreviewKeyDown="List_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
