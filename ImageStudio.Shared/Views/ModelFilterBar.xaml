<UserControl x:Class="ImageStudio.Views.ModelFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ImageStudio.Localization"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <Border Style="{StaticResource Panel}">
        <StackPanel>
            <TextBlock Text="{loc:T filter.title}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="{loc:T filter.search}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         ToolTip="{loc:T filter.search.tip}"/>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:T filter.provider}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Providers, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding ActiveProvider, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>

            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="{loc:T filter.image}" IsChecked="{Binding InputImageOnly}" Margin="0,0,16,6"
                          Visibility="{Binding ShowImageFilter, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                <views:TriStateToggle Value="{Binding Nsfw}" Label="{loc:T filter.nsfw}"
                                      OnlyText="{loc:T filter.tri.only}" AnyText="{loc:T filter.tri.any}" ExcludeText="{loc:T filter.tri.exclude}"
                                      OnlyTip="{loc:T filter.tri.only.tip}" AnyTip="{loc:T filter.tri.any.tip}" ExcludeTip="{loc:T filter.tri.exclude.tip}"/>
            </WrapPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="{loc:T filter.preferred}" IsChecked="{Binding PreferredOnly}" VerticalAlignment="Center"
                          ToolTip="{loc:T filter.preferred.tip}"/>
                <Button Grid.Column="1" Content="{loc:T filter.browse}" Padding="10,2" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenModelBrowserCommand}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
