<UserControl x:Class="ImageStudio.Views.ModelFilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Panel}">
        <StackPanel>
            <TextBlock Text="Filtry modeli" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="Szukaj po nazwie modelu" Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Dostawca:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="Przyjmuje obraz" IsChecked="{Binding InputImageOnly}" Margin="0,0,16,0"/>
                <CheckBox Content="Ukryj NSFW" IsChecked="{Binding HideNsfw}"/>
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="★ Tylko preferowane" IsChecked="{Binding PreferredOnly}" VerticalAlignment="Center"
                          ToolTip="Zapamiętywane osobno dla każdego dostawcy"/>
                <Button Grid.Column="1" Content="Przeglądaj modele…" Padding="10,2"
                        Command="{Binding OpenModelBrowserCommand}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
