<UserControl x:Class="ImageStudio.Tabs.Generate.GenerationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <Button Content="Edytuj prompt..." Height="34" Command="{Binding EditGeneratePromptCommand}"
                    ToolTip="Edytor promptu w osobnym oknie: konfiguracja, koncept, przebudowa AI"/>

            <UniformGrid Columns="2" Margin="0,4,0,0">
                <Button Content="Zapisz zestaw" Margin="0,0,4,0"
                        Command="{Binding SavePresetCommand}" ToolTip="Zapisz prompt, model i parametry jako zestaw"/>
                <Button Content="Zestawy..."
                        Command="{Binding OpenPresetsCommand}" ToolTip="Wczytaj lub zarządzaj zapisanymi zestawami"/>
            </UniformGrid>


            <views:ModelPicker Header="Model" HasFilters="True" ReloadCommand="{Binding ReloadModelsCommand}" Margin="0,4,0,0"
                               ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}"/>

            <Expander Header="Parametry obrazu" Margin="0,0,0,6">
                <StackPanel Margin="0,4,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Seed" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <TextBox Grid.Column="1" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pusty = losowy. Liczba = powtarzalny wynik"/>
                        <TextBlock Grid.Column="2" Text="Jakość" VerticalAlignment="Center" Margin="10,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                  ToolTip="auto = nie wysyłamy parametru jakości"/>
                    </Grid>
                    <TextBlock Text="Negatywny prompt" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Czego nie chcesz w obrazie (działa, gdy model to obsługuje)"/>
                </StackPanel>
            </Expander>

            <Expander Header="Proporcje i rozmiar wyjścia" IsExpanded="True" Margin="0,0,0,10">
                <views:SizePanel Margin="0,4,0,0"/>
            </Expander>

            <Button Content="Generuj" Height="34" Command="{Binding GenerateCommand}" ToolTip="Ctrl+Enter"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
