<UserControl x:Class="ImageStudio.Tabs.Generate.GenerationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
             xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared">
    <!-- Główna akcja jest przypięta pod przewijanym formularzem: zawsze widoczna, bez przewijania na dół -->
    <DockPanel>
        <Button Content="{loc:T gen.generate}" Height="34" DockPanel.Dock="Bottom" Margin="10,6,10,10" Command="{Binding GenerateCommand}" ToolTip="Ctrl+Enter"/>
        <!-- Czemu akcja jest wyłączona: brak modelu, promptu albo obrazu wejściowego -->
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,0" Text="{loc:T hint.noPrompt}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GeneratePrompt}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,0" Text="{loc:T hint.noModel}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <!-- Układ każdej zakładki: Model, Prompt, Wejście, Parametry, Rozmiar, Akcja -->
            <views:ModelPicker Header="{loc:T common.model}" HasFilters="True" FiltersContext="{Binding GenerateFilter}" ReloadCommand="{Binding ReloadModelsCommand}"
                               ItemsSource="{Binding ModelsView}" SelectedItem="{Binding SelectedModel}"/>

            <Button Content="{loc:T common.editPrompt}" Height="34" Margin="0,4,0,0" Command="{Binding EditGeneratePromptCommand}"
                    ToolTip="{loc:T common.editPrompt.tip}"/>
            <!-- Podgląd promptu: bez niego nie widać, co pójdzie do modelu (pełna edycja w oknie) -->
            <TextBlock Text="{Binding GeneratePrompt}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"
                       Margin="2,4,0,6" ToolTip="{Binding GeneratePrompt}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <UniformGrid Columns="2" Margin="0,4,0,8">
                <Button Content="{loc:T common.savePreset}" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SavePresetCommand}" ToolTip="{loc:T common.savePreset.tip}"/>
                <Button Content="{loc:T common.presets}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenPresetsCommand}" ToolTip="{loc:T common.presets.tip}"/>
            </UniformGrid>

            <Expander Header="{loc:T gen.imageParams}" Margin="0,0,0,6">
                <StackPanel Margin="0,4,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:T gen.seed}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <TextBox Grid.Column="1" Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:T gen.seed.tip}"/>
                        <TextBlock Grid.Column="2" Text="{loc:T gen.quality}" VerticalAlignment="Center" Margin="10,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                        <ComboBox Grid.Column="3" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding SelectedQuality}"
                                  ToolTip="{loc:T gen.quality.tip}"/>
                    </Grid>
                    <TextBlock Text="{loc:T gen.negative}" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{loc:T gen.negative.tip}"/>
                </StackPanel>
            </Expander>

            <Expander Header="{loc:T common.sizeSection}" IsExpanded="True" Margin="0,0,0,10">
                <views:SizePanel Margin="0,4,0,0"/>
            </Expander>

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
