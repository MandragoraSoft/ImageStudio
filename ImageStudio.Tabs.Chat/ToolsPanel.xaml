<UserControl x:Class="ImageStudio.Tabs.Chat.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <!-- Narzędzia MCP w zakładce Czat (DataContext = ToolsViewModel) -->
    <Expander Header="{loc:T tools.header}" Margin="0,12,0,0">
        <StackPanel Margin="0,6,0,0">
            <CheckBox Content="{loc:T tools.enable}" IsChecked="{Binding UseTools}"/>
            <CheckBox Content="{loc:T tools.confirm}" IsChecked="{Binding RequireApproval}" Margin="0,4,0,0"
                      ToolTip="{loc:T tools.confirm.tip}"/>

            <CheckBox IsChecked="{Binding AppControlEnabled}" Margin="0,4,0,0"
                      ToolTip="{loc:T tools.control.tip}">
                <TextBlock Text="{loc:T tools.control}" TextWrapping="Wrap"/>
            </CheckBox>

            <TextBlock Text="{loc:T tools.servers}" Style="{StaticResource SectionHeader}"/>
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6" ToolTip="{Binding Description}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="22,0,0,0"
                                       Style="{StaticResource MutedTextBlock}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Foreground="OrangeRed"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:T tools.openJson}" Padding="10,4" Margin="0,0,6,0" Command="{Binding OpenConfigCommand}"/>
                <Button Content="{loc:T tools.reload}" Padding="10,4" Command="{Binding ReloadCommand}"/>
            </StackPanel>

            <TextBlock Text="{loc:T tools.server}" Style="{StaticResource SectionHeader}"/>
            <CheckBox IsChecked="{Binding Server.Enabled}">
                <TextBlock Text="{loc:T tools.server.enable}" TextWrapping="Wrap"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{loc:T tools.port}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                <TextBox Text="{Binding Server.Port, UpdateSourceTrigger=LostFocus}" Width="70"/>
            </StackPanel>
            <TextBlock Text="{Binding Server.Status}" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>
            <Button Content="{loc:T tools.copyConfig}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                    Command="{Binding Server.CopyConfigCommand}"
                    ToolTip="{loc:T tools.copyConfig.tip}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"
                       Text="{loc:T tools.server.note}"/>

            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0"
                       Text="{loc:T tools.json.note}"/>
        </StackPanel>
    </Expander>
</UserControl>
