<UserControl x:Class="ImageStudio.Tabs.Chat.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared">
    <!-- Narzędzia MCP w zakładce Czat (DataContext = ToolsViewModel) -->
    <Expander Margin="0,12,0,0">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:T tools.header}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center"/>
            </StackPanel>
        </Expander.Header>
        <StackPanel Margin="0,6,0,0">
            <CheckBox Content="{loc:T tools.enable}" IsChecked="{Binding UseTools}"/>
            <CheckBox Content="{loc:T tools.confirm}" IsChecked="{Binding RequireApproval}" Margin="0,4,0,0"
                      ToolTip="{loc:T tools.confirm.tip}"/>
            <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                <TextBlock Text="{Binding PermissionsSummary}" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Center"/>
                <Button Content="{loc:T tools.permissions.forget}" Padding="8,2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ForgetPermissionsCommand}" ToolTip="{loc:T tools.permissions.forget.tip}"/>
            </StackPanel>

            <!-- Grupy narzędzi: pole przy grupie włącza i wyłącza wszystkie jej narzędzia, pola w środku każde osobno -->
            <TextBlock Text="{loc:T tools.available}" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding ToolSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T tools.search}" Margin="0,2,0,4"/>
            <CheckBox IsChecked="{Binding SortBySize}" Content="{loc:T tools.sortBySize}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding ToolGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2,0,0" ToolTip="{Binding Description}"
                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Counter}" Margin="6,0,0,0" Style="{StaticResource MutedTextBlock}"/>
                                        <TextBlock Text="{Binding TokensText}" Margin="6,0,0,0" Style="{StaticResource MutedTextBlock}"/>
                                    </StackPanel>
                                </CheckBox>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Tools}" Margin="26,2,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="0,1,0,1" ToolTip="{Binding Description}"
                                                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"/>
                                                <TextBlock Text="{Binding TokensText}" Margin="6,0,0,0" Style="{StaticResource MutedTextBlock}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasBuiltin, Converter={StaticResource BoolToVis}}">
                <Button Content="{loc:T tools.openMemory}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding OpenMemoryCommand}"
                        ToolTip="{loc:T tools.openMemory.tip}"/>
                <Button Content="{loc:T tools.openFiles}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding OpenWorkspaceCommand}"
                        ToolTip="{loc:T tools.openFiles.tip}"/>
                <Button Content="{loc:T tools.openSkills}" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSkillsCommand}"
                        ToolTip="{loc:T tools.openSkills.tip}" Visibility="{Binding HasSkills, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <TextBlock Text="{loc:T tools.servers}" Style="{StaticResource SectionHeader}"/>
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6" ToolTip="{Binding Description}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}"/>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="22,0,0,0"
                                       Style="{StaticResource MutedTextBlock}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedTextBlock}" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding TokensSummary}" Style="{StaticResource MutedTextBlock}"/>
            <TextBlock Text="{Binding LimitWarning}" TextWrapping="Wrap" Foreground="OrangeRed"/>
            <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Foreground="OrangeRed"/>

            <!-- Profile: zapisany zestaw wyłączonych narzędzi; zastosowanie przywraca go jednym kliknięciem -->
            <TextBlock Text="{loc:T tools.profiles}" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" MinWidth="160" Margin="0,0,6,0"/>
                <Button Content="{loc:T tools.profile.apply}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyProfileCommand}"/>
                <Button Content="{loc:T tools.profile.delete}" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteProfileCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,6,0" ToolTip="{loc:T tools.profile.name}"/>
                <Button Content="{loc:T tools.profile.save}" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding SaveProfileCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:T tools.openJson}" Padding="10,4" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding OpenConfigCommand}"/>
                <Button Content="{loc:T tools.reload}" Padding="10,4" Style="{StaticResource SecondaryButton}" Command="{Binding ReloadCommand}"/>
            </StackPanel>

            <TextBlock Text="{loc:T tools.server}" Style="{StaticResource SectionHeader}"/>
            <CheckBox IsChecked="{Binding Server.Enabled}">
                <TextBlock Text="{loc:T tools.server.enable}" TextWrapping="Wrap"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{loc:T tools.port}" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}"/>
                <TextBox Text="{Binding Server.Port, UpdateSourceTrigger=LostFocus}" Width="70"/>
            </StackPanel>
            <TextBlock Text="{Binding Server.Status}" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>
            <Button Content="{loc:T tools.copyConfig}" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                    Command="{Binding Server.CopyConfigCommand}"
                    ToolTip="{loc:T tools.copyConfig.tip}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,6,0,0"
                       Text="{loc:T tools.server.note}"/>

            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,8,0,0"
                       Text="{loc:T tools.json.note}"/>
        </StackPanel>
    </Expander>
</UserControl>
