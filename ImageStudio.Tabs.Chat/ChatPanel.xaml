<UserControl x:Class="ImageStudio.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ImageStudio.Views">
    <!-- Opcje czatu (DataContext = ChatViewModel); sama rozmowa jest po prawej w ChatConversation -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <views:ModelPicker Header="Model czatu"
                               ReloadCommand="{Binding DataContext.ReloadModelsCommand, RelativeSource={RelativeSource AncestorType=Window}}" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/>

            <TextBlock Text="Instrukcja systemowa (opcjonalna)" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"
                     ToolTip="Wysyłana na początku każdej rozmowy, np. rola lub styl odpowiedzi"/>

            <Button Content="Nowa rozmowa" Margin="0,12,0,0" Command="{Binding NewChatCommand}"/>

            <views:ToolsPanel DataContext="{Binding Tools}"/>

            <TextBlock Text="Historia rozmowy jest tylko w pamięci i znika po zamknięciu aplikacji. Ctrl+Enter wysyła wiadomość."
                       TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
