<UserControl x:Class="ImageStudio.Tabs.Edit.EditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ImageStudio.Tabs.Edit"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
             xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared">
    <UserControl.Resources>
        <local:ReferenceThumbnailConverter x:Key="ReferenceThumbnail"/>
    </UserControl.Resources>
    <!-- Główna akcja jest przypięta pod przewijanym formularzem: zawsze widoczna, bez przewijania na dół -->
    <DockPanel>
        <Button Content="{loc:T edit.run}" Height="34" DockPanel.Dock="Bottom" Margin="10,6,10,10" Command="{Binding EditCommand}" ToolTip="Ctrl+Enter"/>
        <!-- Czemu akcja jest wyłączona: brak modelu, promptu albo obrazu wejściowego -->
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,0" Text="{loc:T hint.noPrompt}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditPrompt}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,0" Text="{loc:T hint.noImage}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding References.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock DockPanel.Dock="Bottom" Margin="10,0,10,0" Text="{loc:T hint.noModel}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedEditModel}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <views:ModelPicker Header="{loc:T common.model}" HasFilters="True" FiltersContext="{Binding EditFilter}" ReloadCommand="{Binding ReloadModelsCommand}"
                               ItemsSource="{Binding EditModelsView}" SelectedItem="{Binding SelectedEditModel}"/>

            <Button Content="{loc:T common.editPrompt}" Height="34" Margin="0,4,0,0" Command="{Binding EditEditPromptCommand}"
                    ToolTip="{loc:T common.editPrompt.tip}"/>
            <!-- Podgląd promptu: bez niego nie widać, co pójdzie do modelu (pełna edycja w oknie) -->
            <TextBlock Text="{Binding EditPrompt}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"
                       Margin="2,4,0,6" ToolTip="{Binding EditPrompt}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <UniformGrid Columns="2" Margin="0,4,0,8">
                <Button Content="{loc:T common.savePreset}" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SavePresetCommand}" ToolTip="{loc:T common.savePreset.tip}"/>
                <Button Content="{loc:T common.presets}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenPresetsCommand}" ToolTip="{loc:T common.presets.tip}"/>
            </UniformGrid>

            <Expander Margin="0,0,0,6" Header="{loc:T common.inputImages}" IsExpanded="True">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{loc:T edit.refs.note}" TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:T common.add}" Width="90" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding AddReferencesCommand}"/>
                        <Button Content="{loc:T common.clear}" Width="90" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Command="{Binding ClearReferencesCommand}"/>
                        <Button Content="{loc:T common.pasteClipboard}" Padding="10,6" Style="{StaticResource SecondaryButton}" Command="{Binding PasteReferenceCommand}"
                                ToolTip="{loc:T edit.paste.tip}"/>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{loc:T edit.addUrl}" Width="110" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddReferenceFromUrlCommand}"/>
                        <TextBox Text="{Binding ReferenceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:T edit.url.tip}"/>
                    </DockPanel>

                    <ListBox x:Name="ReferenceList" ItemsSource="{Binding References}" MaxHeight="340" Margin="0,0,0,10"
                             Tag="{Binding MoveReferenceCommand}" AllowDrop="True" AlternationCount="2147483647"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="ReferencesMouseDown" PreviewMouseMove="ReferencesMouseMove"
                             PreviewMouseLeftButtonUp="ReferencesMouseUp" DragOver="ReferencesDragOver" Drop="ReferencesDrop"
                             AutomationProperties.Name="{loc:T common.inputImages}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="1">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding References.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="132" Margin="2" Padding="4" BorderBrush="{DynamicResource BorderSoftBrush}"
                                        BorderThickness="1" CornerRadius="6" ToolTip="{Binding Source}">
                                    <StackPanel>
                                        <Image Source="{Binding Path, Converter={StaticResource ReferenceThumbnail}}" Height="100" Stretch="Uniform"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Text="{loc:T edit.refs.primary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <Button Content="←" Width="34" Padding="0" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                                                    ToolTip="{loc:T edit.refs.moveLeft}" AutomationProperties.Name="{loc:T edit.refs.moveLeft}"
                                                    Command="{Binding DataContext.MoveReferenceLeftCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <Button Content="→" Width="34" Padding="0" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}"
                                                    ToolTip="{loc:T edit.refs.moveRight}" AutomationProperties.Name="{loc:T edit.refs.moveRight}"
                                                    Command="{Binding DataContext.MoveReferenceRightCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <Button Content="×" Width="34" Padding="0" Style="{StaticResource SecondaryButton}"
                                                    ToolTip="{loc:T edit.refs.remove}" AutomationProperties.Name="{loc:T edit.refs.remove}"
                                                    Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>

            <Expander Header="{loc:T common.sizeSection}" IsExpanded="True" Margin="0,0,0,6">
                <StackPanel>
                    <views:SizePanel Margin="0,4,0,0"/>
                    <TextBlock Text="{loc:T edit.sizeNote}"
                               TextWrapping="Wrap" Style="{StaticResource MutedTextBlock}" Margin="0,4,0,0"/>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
