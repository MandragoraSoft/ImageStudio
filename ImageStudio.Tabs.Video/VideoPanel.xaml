<UserControl x:Class="ImageStudio.Tabs.Video.VideoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ImageStudio.Localization;assembly=ImageStudio.Shared"
             xmlns:views="clr-namespace:ImageStudio.Views;assembly=ImageStudio.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>
            <views:ModelPicker Header="{loc:T common.model}" HasFilters="True"
                               ReloadCommand="{Binding ReloadModelsCommand}" ItemsSource="{Binding VideoModelsView}" SelectedItem="{Binding SelectedVideoModel}"/>

            <Button Content="{loc:T common.editPrompt}" Height="34" Margin="0,4,0,8" Command="{Binding EditVideoPromptCommand}"
                    ToolTip="{loc:T common.editPrompt.tip}"/>

            <Expander Header="{loc:T common.inputImages}" IsExpanded="True" Margin="0,0,0,6">
                <StackPanel Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:T common.add}" Width="90" Margin="0,0,6,0" Command="{Binding AddVideoAttachmentsCommand}"/>
                        <Button Content="{loc:T common.clear}" Width="90" Margin="0,0,6,0" Command="{Binding ClearVideoAttachmentsCommand}"/>
                        <Button Content="{loc:T common.pasteClipboard}" Padding="10,6" Command="{Binding PasteVideoAttachmentCommand}"
                                ToolTip="{loc:T video.paste.tip}"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding VideoAttachments}" Height="110">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="{Binding Source}">
                                    <Button DockPanel.Dock="Right" Content="×" Width="26" Padding="0" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.RemoveVideoAttachmentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding VideoHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Expander>


            <Expander Header="{loc:T video.timeAspect}" IsExpanded="True" Margin="0,8,0,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock><Run Text="{loc:T video.duration}"/><Run Text="{Binding VideoDuration, Mode=OneWay}"/><Run Text=" s"/></TextBlock>
                    <Slider Minimum="2" Maximum="10" Value="{Binding VideoDuration}"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{loc:T video.aspect}" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding VideoAspects}" SelectedItem="{Binding VideoAspect}"/>
                </StackPanel>
            </Expander>

            <TextBlock Text="{Binding VideoEstimateLabel}" Style="{StaticResource MutedTextBlock}"
                       TextWrapping="Wrap" Margin="0,10,0,10"/>
            <Button Content="{loc:T video.generate}" Height="34" Command="{Binding GenerateVideoCommand}"/>
            <TextBlock Text="{loc:T video.paidNote}"
                       Style="{StaticResource MutedTextBlock}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
